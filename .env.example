# Set these in your hosting provider's environment settings.
MONGODB_URI=mongodb://127.0.0.1:27017/mern_cloud
JWT_SECRET=replace-with-a-long-random-key
# Use a persistent mounted volume for uploads.
FILE_PATH=/data/files
STATIC_PATH=/data/avatars
PORT=5001
# Client and server share one domain in production.
VITE_API_URL=/
